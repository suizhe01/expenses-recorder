node_modules/
.env
.DS_Store
dist/
# Receipt images written by a local (non-compose) run. This repository is
# public — an uploaded receipt must never be committed.
data/
# Generated by `npm run openapi`; regenerate rather than commit, so it can
# never drift from the routes it claims to describe.
openapi.json
# Default output of scripts/backup.sh. A backup contains the whole database
# and every receipt image; this repository is public.
backups/
*.tsbuildinfo
# Locally installed Claude tooling — third-party skills and agents whose terms
# are not established, so they are not published from this public repository.
# The finn-* skills predate this and stay tracked: ignoring a path does not
# untrack what is already committed. Anything new under .claude/ that SHOULD be
# shared needs `git add -f`.
.claude/
