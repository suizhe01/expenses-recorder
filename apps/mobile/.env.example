# Copy to .env before running the app:
#
#   cp .env.example .env
#
# There is no default. The app refuses to start without this, because the
# obvious default — localhost — is wrong on a phone, where it means the phone
# itself, and produces a confusing network error instead of a clear one.

# Origin of the expenses-recorder API.
#
# Use your development machine's LAN address, NOT localhost, so a physical
# device on the same WiFi can reach it. Find it with:
#
#   ipconfig getifaddr en0        # macOS
#
# The API must also have PUBLIC_BASE_URL set to this same origin, or the
# verification links it emails will point at a host your phone cannot open.
# After changing that, run `docker compose up -d` — `restart` reuses the old
# environment and the new value never arrives.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
