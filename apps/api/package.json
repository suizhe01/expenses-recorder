{
  "name": "@expenses-recorder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "prune:sessions": "tsx src/scripts/prune-sessions.ts",
    "openapi": "tsx src/scripts/write-openapi.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.2.1",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "resend": "^6.18.1",
    "yazl": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8",
    "yauzl": "^3.4.0"
  }
}
