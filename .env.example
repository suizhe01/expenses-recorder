# Copy to .env before the first run. The defaults below work as-is for local
# development — no edits required.
#
#   cp .env.example .env
#   docker compose up

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# Interface the API binds to. 0.0.0.0 is required inside a container.
HOST=0.0.0.0

# Host port the API is published on.
PORT=3000

# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string used when running the API or migrations FROM THE
# HOST (npm run dev, npm run migrate). Points at the compose database on its
# published host port. The api container overrides this with the in-network
# address; see docker-compose.yml.
DATABASE_URL=postgres://expenses:expenses@localhost:5433/expenses

# ---------------------------------------------------------------------------
# Postgres container
# ---------------------------------------------------------------------------

POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
POSTGRES_DB=expenses

# Host port for the compose database. Defaults to 5433 rather than 5432 so it
# does not collide with a Postgres already installed on the machine.
POSTGRES_PORT=5433
