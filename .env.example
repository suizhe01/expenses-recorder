# Copy to .env before the first run. The defaults below work as-is for local
# development — no edits required.
#
#   cp .env.example .env
#   docker compose up

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# Interface the API binds to. 0.0.0.0 is required inside a container.
HOST=0.0.0.0

# Host port the API is published on.
PORT=3000

# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Signing key for access tokens. Minimum 32 characters — the API refuses to
# start otherwise. The value below is a placeholder for local development ONLY;
# generate a real one before exposing the API:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it invalidates every issued access token.
JWT_SECRET=local-development-only-change-me-before-deploying

# Postgres connection string used when running the API or migrations FROM THE
# HOST (npm run dev, npm run migrate). Points at the compose database on its
# published host port. The api container overrides this with the in-network
# address; see docker-compose.yml.
DATABASE_URL=postgres://expenses:expenses@localhost:5433/expenses

# Origin the API is reachable on. Used to build verification links, which are
# opened from an email on some other device, so it cannot be derived from the
# incoming request. Set this to your Cloudflare Tunnel hostname in production.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Optional. Leave unset and verification links are written to the API log
# instead of being emailed — which is how local development and CI work.
# Get a key at https://resend.com (free tier, no card).
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Resend's shared test sender. Needs no domain and no DNS, but it ONLY delivers
# to the email address on your own Resend account. Point this at your own
# verified domain to reach anyone else.
MAIL_FROM=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Receipts
# ---------------------------------------------------------------------------

# Where receipt images are stored. Under docker compose this is overridden to
# /data/receipts, backed by the named `receipts-data` volume, so the archive
# outlives the container. Running the API directly uses the path below.
RECEIPTS_PATH=./data/receipts

# Largest single upload, in bytes. 10 MiB by default.
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Receipt extraction
# ---------------------------------------------------------------------------

# Optional. Leave unset and receipts are stored without being read: uploads
# still succeed and the attempt is recorded as skipped, so the tests and a
# fresh clone work with no key and no network.
# Get one at https://aistudio.google.com (free tier, no card).
# GEMINI_API_KEY=

# The model receipts are read with. Recorded on every attempt.
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Postgres container
# ---------------------------------------------------------------------------

POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
POSTGRES_DB=expenses

# Host port for the compose database. Defaults to 5433 rather than 5432 so it
# does not collide with a Postgres already installed on the machine.
POSTGRES_PORT=5433
